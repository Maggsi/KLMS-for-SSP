{% if sponsor.active() and settings.get("sponsor.banner.show") %}
    {% set sponsors = sponsor.carouselSponsors %}
    {% if sponsors is not empty %}
        <div id="foot-bar" class="container py-3">
            {% if settings.get("sponsor.banner.show_title", true) %}
            <h2 class="text-center mb-1">{{ settings.get("sponsor.banner.title") | default("Supported by") }}</h2>
            {% endif %}
            <div id="sponsor-carousel" class="carousel slide" data-ride="carousel">
                <div class="carousel-inner">
                    {% for s in sponsors %}
                    <div class="carousel-item{% if loop.first %} active{% endif %}">
                        <div class="sponsor-slide">
                            <a{% if s.url is not empty %} href="{{ s.url }}" target="_blank"{% endif %}>
                                {% if vich_uploader_asset(s, 'logoFile') is not null %}
                                <img class="sponsor-banner-logo" src="{{ vich_uploader_asset(s, 'logoFile') | imagine_filter('sponsor_logo') }}" alt="{{ s.name }}">
                                {% endif %}
                            </a>
                            <div class="text-center">
                                {% if settings.get("sponsor.banner.show_name", false) and s.name is not empty %}
                                <h5>{{ s.name }}</h5>
                                {% endif %}
                                {% if settings.get("sponsor.banner.show_text", false) %}
                                <p>{{ s.text | raw }}</p>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
                {% if sponsors|length > 1 %}
                <a class="carousel-control-prev" href="#sponsor-carousel" role="button" data-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="sr-only">Previous</span>
                </a>
                <a class="carousel-control-next" href="#sponsor-carousel" role="button" data-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="sr-only">Next</span>
                </a>
                {% endif %}
            </div>
        </div>
    {% endif %}
{% endif %}
