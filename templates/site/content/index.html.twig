{% extends 'site/siteBase.html.twig' %}

{% block title %}{{ settings.get('site.title') }} - {{ content.title }}{% endblock %}

{% block main %}
    <div class="container mb-5">
        <div class="row mb-2">
            <div class="col">
                <h1 class="text-center">{{ content.title }}</h1>
            </div>
        </div>
        <div class="card">
            <div class="card-body p-4 p-lg-5">
                <div class="card-text content-scroll">
                    {{ content.content|raw }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
