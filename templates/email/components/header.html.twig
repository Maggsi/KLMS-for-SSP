{# TODO embedd logo to make it independent of changes #}
<div class="head-wrap"
     style="background-color:#0e0e12;"
     {% if settings.get('style.bg_image') is not empty %}
     style="background-color:#0e0e12; background-image: url({{ absolute_url(settings.get('style.bg_image')) }})"
     {% endif %}
>
    <div class="head-content container">
        <div style="padding-top:1.5rem;padding-bottom:1.5rem;">
        <a href="{{ url('news') }}">
            {% if settings.get('style.logo_email') is not empty %}
                <img style="max-width:100%;height:auto;" class="logo {% if settings.get('style.logo_full_height') %}logo-full-height{% endif %}" src="{{ absolute_url(settings.get('style.logo_email')) }}" alt="Logo"/>
            {% elseif settings.get('style.logo') is not empty %}
                <img style="max-width:100%;height:auto;" class="logo {% if settings.get('style.logo_full_height') %}logo-full-height{% endif %}" src="{{ absolute_url(settings.get('style.logo')) }}" alt="Logo"/>
            {% else %}
                <span style="font-family:'Iceland','Lucida Console','Courier New',monospace;color:#fdd901;font-size:14px;letter-spacing:.18em;text-transform:uppercase;overflow-wrap:break-word;">SSP://LASTLAN</span>
            {% endif %}
        </a>
        </div>
    </div>
</div>