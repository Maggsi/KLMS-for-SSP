<div class="container py-2">
    <div class="row small ssp-footer">
        <div class="col text-left">
            {{ settings.get('site.organisation') }}
        </div>
        <div class="col text-right">
            {% set imprint = 'imprint' is slug %}
            {% set unsub = unsubscribe is defined %}
            {% if imprint %}
                <a href="{{ absolute_url(slug_url('imprint')) }}">Impressum</a>
            {% endif %}
            {% if imprint and unsub %} | {% endif %}
            {% if unsub %}
                <a  href="{{ url('email_unsubscribe', {'token' : unsubscribe}) }}">Unsubscribe</a>
            {% endif %}
        </div>
    </div>
    <div class="row">
        <div class="col ssp-hudline" style="text-align:center;padding-top:6px;">SSP://KLMS &nbsp;·&nbsp; SYSTEM MAIL</div>
    </div>
</div>