{% apply inline_css(encore_entry_css_source('email')) %}
<!doctype html>
<html lang="de">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width">
    {# Declare dark-awareness: stops Gmail Android/Chromium forced auto-darkening
       color rewrites (google Chrome auto-dark opt-out + email-dev consensus). #}
    <meta name="color-scheme" content="light dark">
    <meta name="supported-color-schemes" content="light dark">
    <title>{% block subject %}{% endblock %}</title>
    <style>
        /* Gmail dark-mode engines (iOS color dictionary, Android auto-darkening)
           lift dark text sitting on yellow. The CTA is inverted (dark surface +
           yellow label — the only variant readable on device), so guards just
           re-assert both colors through every known Gmail wrapper. */
        .ssp-cta,
        [data-ogsc] .ssp-cta,
        [data-ogsb] .ssp-cta,
        u + .body .ssp-cta {
            background-color: #1f1f25 !important;
            color: #fdd901 !important;
            -webkit-text-fill-color: #fdd901 !important;
            border: 2px solid #fdd901 !important;
        }
    </style>
</head>
<body>
<div class="body">
    {% block body %}{% endblock %}
</div>
</body>
</html>
{% endapply %}