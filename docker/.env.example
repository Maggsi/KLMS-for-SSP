# Copy to docker/.env and fill in real values (docker/.env is gitignored).
# For local testing on bigboy, the fixed test values below are fine.

# --- postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_test_pw
# Two-tier users per app (see initdb/setup.sh + README "DB users"):
#   <app>_dot      = application user (owns the DB: read/write + runtime table creation)
#   <app>_dot_mig  = migration user (all rights, for doctrine:schema / migrations)
KLMS_DB_USER=klms_dot
KLMS_DB_PASSWORD=klms_dot_test_pw
KLMS_MIGRATION_DB_PASSWORD=klms_dot_mig_test_pw
KLMS_DB_NAME=klms_dot
IDM_DB_USER=idm_dot
IDM_DB_PASSWORD=idm_dot_test_pw
IDM_MIGRATION_DB_PASSWORD=idm_dot_mig_test_pw
IDM_DB_NAME=idm_dot

# --- klms ---
KLMS_APP_ENV=prod
KLMS_APP_SECRET=***
KLMS_DATABASE_URL=postgresql://klms_dot:klms_dot_test_pw@postgres:5432/klms_dot?serverVersion=16&charset=utf8
KLMS_IDM_URL=http://idm:8095
KLMS_IDM_APIKEY=***
KLMS_IDM_AUTH=***
KLMS_MAILER_DSN=null://null
KLMS_MAILER_DEFAULT_SENDER_NAME=KLMS
KLMS_MAILER_DEFAULT_SENDER_EMAIL=noreply@example.test
KLMS_SITE_BASE_SCHEME=http
KLMS_SITE_BASE_HOST=192.168.0.170:8094
KLMS_RECAPTCHA3_ENABLED=0
KLMS_MESSENGER_TRANSPORT_DSN=doctrine://default
KLMS_SENTRY_DSN=
KLMS_CARTO_BASEMAP_API_KEY=

# --- idm ---
IDM_APP_ENV=prod
IDM_APP_SECRET=***
IDM_DATABASE_URL=postgresql://idm_dot:idm_dot_test_pw@postgres:5432/idm_dot?serverVersion=16&charset=utf8
