APP_ENV=prod
SENTRY_DSN=
MAILER_DSN=null://null
# Bundle defaults referenced via %env(...)% that the compose `environment:`
# block does NOT inject. Without them the kernel fails the moment a controller
# autowires the wallet/vapid services (e.g. /user -> WALLET*API_KEY).
# Values mirror the tracked root .env (safe, non-secret defaults).
VAPID_SUBJECT=mailto:admin@example.test
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
WALLETWALLET_API_KEY=
WALLETWALLET_LOGO_DATA_URI=
WALLETWALLET_ICON_DATA_URI=
WALLETWALLET_STRIP_DATA_URI=
RECAPTCHA3_KEY=
RECAPTCHA3_SECRET=
